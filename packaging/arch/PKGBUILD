# Maintainer: unom <packages@unom.io>
#
# Arch Linux / SteamOS split package: rubyfunk-host (the gaming-rig HOST, NVENC) and
# rubyfunk-client (the native GTK4/libadwaita Linux CLIENT). Mirrors the rpm subpackages
# (packaging/rpm/rubyfunk.spec) and the two deb build scripts. On a Steam Deck you want
# `rubyfunk-client` (it's what the Decky plugin launches); on a gaming rig, `rubyfunk-host`.
#
# Two build modes:
#   - AUR / standalone:  makepkg in this dir (fetches the git tag below).
#   - In-tree / CI:       PF_SRCDIR=$(git rev-parse --show-toplevel) makepkg --holdver
#                         (builds the working tree instead of the tagged source — see build()).
#
# Host encode: NVENC on NVIDIA (nvidia-utils), VAAPI on AMD/Intel (mesa) — RUBYFUNK_ENCODER=auto
# picks per GPU. The CLIENT decodes via VAAPI (AMD/Intel, incl. the Deck) with a software
# fallback, so it works everywhere. See README.md.
pkgbase=rubyfunk
# rubyfunk-web (the browser console) and rubyfunk-scripting (the plugin/script runner) are OPT-IN:
# both need `bun` (AUR-only as bun-bin on stock Arch/SteamOS), so a default makepkg builds only
# host+client with no JS tooling — mirroring the RPM spec's `%bcond_with web` / `%bcond_with
# scripting` (off by default). Set PF_WITH_WEB=1 / PF_WITH_SCRIPTING=1 to also build them (each
# appends its pkgname + bun to makedepends below).
# aarch64 (Arch Linux ARM) is CLIENT-ONLY — see the `arch` note below. Dropping the host from
# `pkgname` (rather than giving package_rubyfunk-host a per-package arch) is what keeps makepkg
# from entering the host's build/package path at all, and mirrors how PF_WITH_WEB extends this
# array further down.
if [ "${CARCH:-x86_64}" = 'aarch64' ]; then
  pkgname=('rubyfunk-client' 'rubyfunk-icons')
else
  pkgname=('rubyfunk-host' 'rubyfunk-client' 'rubyfunk-icons' 'rubyfunk-seats')
fi
# CI (.gitea/workflows/arch.yml) drives the version: stable tags -> X.Y.Z-1, main pushes ->
# X.Y.Z-0.<run#> in the separate rubyfunk-canary repo (mirrors the RPM's 0.ciN release; pkgrel
# allows only digits+dots, so the run number carries the monotonic ordering).
pkgver="${PF_PKGVER:-0.7.0}"
pkgrel="${PF_PKGREL:-1}"
# The CLIENT builds and runs on aarch64 (Arch Linux ARM); the HOST does not — its encode stack is
# NVENC/QSV/AMF, all x86. On aarch64 the split below drops rubyfunk-host from `pkgname`, so
# makepkg builds only the client and never tries to compile the host crate.
arch=('x86_64' 'aarch64')
url="https://git.unom.io/unom/punktfunk"
license=('MIT OR Apache-2.0')
# !lto: makepkg's `lto` option injects -flto=auto into CFLAGS; aws-lc-sys (rustls' crypto)
# compiles its C with those flags and GCC LTO bitcode objects are unreadable by rust's lld
# linker -> "undefined symbol: aws_lc_*" at link (reproduced 2026-07-04, Arch + rust 1.90).
# !debug: skip the -debug split package (debuginfo bloat, not shipped).
options=('!lto' '!debug')

# All build deps for both packages (Arch runtime packages ship their own headers, so these cover
# build + link). aws-lc/ring need clang+cmake; nasm is for asm. No vulkan-headers:
# nothing in the workspace compiles against the system Vulkan headers any more (pyrowave-sys builds
# against its own vendored copy, and both binaries reach Vulkan through ash, which dlopens it).
makedepends=('rust' 'cargo' 'clang' 'cmake' 'nasm' 'pkgconf' 'git'
             'gtk4' 'libadwaita' 'sdl3' 'pipewire' 'wayland' 'libxkbcommon' 'libei')

# Opt-in rubyfunk-web / rubyfunk-scripting: only then is bun (the build tool AND the vendored
# runtime) required. Adding bun twice is harmless (makepkg dedups makedepends). Either one also
# builds rubyfunk-bun, the one runtime both run on.
if [ "${PF_WITH_WEB:-0}" = 1 ]; then
  pkgname+=('rubyfunk-web')
  makedepends+=('bun')   # `bun-bin` from the AUR if bun isn't in your configured repos
fi
if [ "${PF_WITH_SCRIPTING:-0}" = 1 ]; then
  pkgname+=('rubyfunk-scripting')
  makedepends+=('bun')
fi
if [ "${PF_WITH_WEB:-0}" = 1 ] || [ "${PF_WITH_SCRIPTING:-0}" = 1 ]; then
  pkgname+=('rubyfunk-bun')
fi

# AUR source (a tagged release). For an in-tree CI build, set PF_SRCDIR to the repo root —
# build() uses it instead AND the fetch is skipped entirely (a canary pkgver has no tag to
# clone, and CI already has the checkout).
if [ -z "${PF_SRCDIR:-}" ]; then
  source=("git+https://git.unom.io/unom/punktfunk.git#tag=v${pkgver}")
  sha256sums=('SKIP')
else
  source=()
  sha256sums=()
fi

_repo() { printf '%s' "${PF_SRCDIR:-$srcdir/rubyfunk}"; }

build() {
  cd "$(_repo)"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR="$srcdir/target"
  export RUBYFUNK_BUILD_VERSION="${pkgver}-${pkgrel}"   # stamp --version / mgmt /health (build.rs)
  # The host's zero-copy FFI link-needs libcuda at build time; nvidia-utils provides it on an
  # NVIDIA builder. On a GPU-less builder symlink the CUDA stub into the link path first (same
  # caveat the RPM documents): ln -s "$(find / -name libcuda.so -path '*stubs*'|head -1)" /usr/lib/
  # rubyfunk-client-session is the Vulkan/Skia streamer the shell (rubyfunk-client) execs for
  # a connect — both binaries must ship or streaming from the desktop client breaks.
  # `--features rubyfunk-host/nvenc` compiles in the direct-SDK NVENC path (real RFI + recovery
  # anchor on Linux NVIDIA; design/linux-direct-nvenc.md). AMD/Intel-SAFE: the NVENC/CUDA entry
  # points are dlopen'd at RUNTIME (libloading), never link-imported — `objdump -p` shows the same
  # DT_NEEDED as a plain build (no libcuda/libnvidia-encode), so the binary starts fine driver-less
  # and only touches NVIDIA on a CUDA capture frame. AMD/Intel never reach it — the `cuda` gate
  # leaves them on VAAPI. Without this feature an NVIDIA box has no NVENC at all.
  # `rubyfunk-host/vulkan-encode` is the AMD/Intel twin: a raw VK_KHR_video_encode_h265 backend with
  # real RFI (clean P-frame recovery anchor via DPB reference slots; design/linux-vulkan-video-encode.md).
  # Pure Rust `ash` (no new lib, no link-time deps); default on for HEVC (RUBYFUNK_VULKAN_ENCODE=0
  # opts back to the native VAAPI session), and a failed open falls back to it so unsupported
  # devices are safe.
  if [ "$CARCH" = 'aarch64' ]; then
    # Client-only: no host crate, so none of the encode features below apply. pf-update still
    # builds — the client package ships its own copy for `--apply-update`.
    cargo build --release --locked -p rubyfunk-client-linux -p rubyfunk-client-session \
      -p rubyfunk-cli -p pf-update
  else
  # `-p rubyfunk-encode-worker`: the capability-carrying PyroWave encode worker, shipped next to
  # the host in /usr/bin and setcap'd by rubyfunk-host.install. It MUST be its own file — the host
  # can never carry a capability (KWin identification; see the scriptlet) — and it must ship in the
  # SAME package as the host, because host and worker version-check each other over their socket
  # and fall back to the in-process encoder on any mismatch. Co-built here on purpose: v1 accepts
  # that the worker shares the host's dependency graph (same package, same sonames, no new break
  # class), so cargo's feature unification across this one invocation is harmless.
  # `-p rubyfunk-seats` is the seat supervisor's binary. rubyfunk-host already links its
  # library and pf-inject, so this adds the one executable and no feature unification.
  cargo build --release --locked --features rubyfunk-host/nvenc,rubyfunk-host/vulkan-encode \
    -p rubyfunk-host -p rubyfunk-encode-worker \
    -p rubyfunk-client-linux -p rubyfunk-client-session -p rubyfunk-cli \
    -p pf-update -p rubyfunk-seats
  # The status tray in its OWN cargo invocation — load-bearing, not tidiness. Cargo unifies features
  # across everything in one build, so co-building the tray with the host pulls the host's
  # ashpd -> zbus/tokio onto the tray's shared zbus; the tray (ksni async-io + blocking, no tokio
  # runtime by design) then panics at startup ("there is no reactor running, must be called from the
  # context of a Tokio 1.x runtime"). Built alone, its zbus stays on async-io. (Same split the .deb does.)
  cargo build --release --locked -p rubyfunk-tray
  fi
  # Management web console (opt-in): the Nitro `bun`-preset .output bundle (Bun.serve TLS),
  # built AND run with bun.
  #
  # Build-if-missing, matching packaging/debian/build-web-deb.sh. An in-tree CI build runs with
  # PF_SRCDIR pointing at the workspace, so when arch.yml has restored web/.output from the shared
  # actions cache it is already sitting right here and rebuilding it would be pure duplication —
  # this console was being built six times per push across the fleet. A local `makepkg` has no
  # .output and builds exactly as before.
  #
  # The Bun.serve assertion covers BOTH paths: a reused bundle is one more thing that can be wrong,
  # and node cannot run a Bun.serve entry, so shipping the wrong preset is a dead console.
  if [ "${PF_WITH_WEB:-0}" = 1 ]; then
    if [ -f web/.output/server/index.mjs ]; then
      echo "==> reusing the already-built web console at web/.output"
    else
      ( cd web && bun install --frozen-lockfile && bun run build )
    fi
    grep -q 'Bun\.serve' web/.output/server/index.mjs \
      || { echo "ERROR: web build is not a bun bundle — need the 'bun' preset + custom entry" >&2; exit 1; }
  fi
  # Plugin/script runner (opt-in): one self-contained JS via `bun build --target=bun` (effect + the
  # SDK inlined; the dynamic plugin import stays a runtime import). bun is also its vendored runtime.
  if [ "${PF_WITH_SCRIPTING:-0}" = 1 ]; then
    ( cd sdk && bun install --frozen-lockfile --ignore-scripts && \
      bun build src/runner-cli.ts --target=bun --outfile="$srcdir/runner-cli.js" )
    grep -q 'attempt=' "$srcdir/runner-cli.js" \
      || { echo "ERROR: runner bundle missing the dynamic plugin import — wrong build" >&2; exit 1; }
  fi
}

package_rubyfunk-host() {
  pkgdesc="Low-latency desktop/game streaming HOST (Moonlight-compatible + punktfunk/2)"
  # NVENC + GPU EGL/CUDA come from the NVIDIA driver (nvidia-utils) — kept an optdepend, never a
  # hard dep, exactly as the RPM (__requires_exclude libcuda) and deb (shlibdeps filter) do.
  # The host captures the sink monitor through NATIVE PipeWire (pf-audio) — it never
  # opens a Pulse socket itself, so pipewire-pulse is an OPTdepend, not a depend: it exists
  # for the GAMES, which commonly emit through the PulseAudio API. Hard-depending on it made
  # the package uninstallable next to real `pulseaudio`, which serves those games just as well.
  # rubyfunk-icons: the brand mark the Omarchy webapp entry and the tray name. It lives in its
  # own package because the CLIENT needs the same file — two packages shipping one path is a
  # pacman file conflict the moment both land on one box (found exactly that way).
  # rubyfunk-gamescope: HDR, the real mode and the cursor in every gamescope session. A depend,
  # not an optdepend: pacman has no weak deps, and apt/dnf pull it as a Recommends.
  # rubyfunk-seats: profile seats and Reachable without logging in, shipped off. Pinned, as on
  # apt and dnf: the host and the supervisor speak one socket protocol.
  depends=('pipewire' 'wireplumber' 'libei'
           'mesa' 'libglvnd' 'libxkbcommon' 'wayland' 'rubyfunk-icons' 'rubyfunk-gamescope'
           "rubyfunk-seats=${pkgver}-${pkgrel}")
  optdepends=('rtkit: data-plane thread priority without a relogin (else the shipped LimitNICE drop-in applies from next login)'
              'pipewire-pulse: PulseAudio-API audio from games/apps (real `pulseaudio` also works)'
              'nvidia-utils: NVENC hardware encode + GPU EGL/CUDA zero-copy (REQUIRED to encode on NVIDIA)'
              'gamescope: per-session nested compositor backend (no desktop login needed) — needs >=3.16.22'
              'kwin: stream a KDE Plasma desktop (kwin VirtualDisplay backend)'
              'mutter: stream a GNOME desktop (Mutter RecordVirtual backend)'
              'sway: stream a wlroots desktop (Sway VirtualDisplay backend)'
              # Owed independently of Omarchy: the Hyprland backend has been first-class for
              # releases (headless outputs, xdph capture, exclusive topology) with no dependency
              # naming it, so a Hyprland box could install the host and find capture unavailable.
              'hyprland: stream a Hyprland desktop (headless-output backend) — Omarchy ships this'
              'xdg-desktop-portal-hyprland: ScreenCast portal for the Hyprland backend (REQUIRED to capture on Hyprland)'
              'biri-git: niri host (virtual outputs)'
              'umbriel-git: Umbriel host (virtual outputs)'
              'xdg-desktop-portal-kde: portal for the headless KDE session helper'
              'xdg-desktop-portal-wlr: portal for the headless Sway session helper'
              'rubyfunk-web: browser management console (device pairing + status)'
              'rubyfunk-scripting: plugin/script runner for host automation (bun)')
  install=rubyfunk-host.install
  # User-editable config: the headless game-mode drop-in (see below) — don't clobber local edits.
  backup=('etc/gamescope-session-plus/sessions.d/steam')
  local R; R="$(_repo)"; local T="$srcdir/target/release"

  install -Dm0755 "$T/rubyfunk-host"                 "$pkgdir/usr/bin/rubyfunk-host"
  # The PyroWave encode worker — a SEPARATE file in the same bindir (the host resolves it as a
  # sibling of /proc/self/exe). rubyfunk-host.install setcaps this one, and only this one; the
  # host must stay capability-free or KWin cannot identify it and desktop streaming dies.
  install -Dm0755 "$T/rubyfunk-encode-worker"        "$pkgdir/usr/bin/rubyfunk-encode-worker"
  # /dev/uinput + /dev/uhid -> input group (virtual gamepads + DualSense UHID)
  install -Dm0644 "$R/scripts/60-rubyfunk.rules"     "$pkgdir/usr/lib/udev/rules.d/60-rubyfunk.rules"
  install -Dm0644 "$R/scripts/60-rubyfunk-dualsense.conf" \
                                                      "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/60-rubyfunk-dualsense.conf"
  # ALSA UCM for the DualSense's own sound card — the `SpeakerHaptic` device alsa-ucm-conf has
  # never carried. Without it the pad's only playback route is a 1-channel `Speaker` split, and a
  # game that opens GE-Proton's "Sony controller speaker" endpoint overruns it. Keyed by USB
  # vid:pid, these only redefine which profile the pad resolves to, so nothing alsa-ucm-conf owns
  # is replaced — no `conflicts=`, no `backup=`. Complements the WirePlumber rules above rather
  # than overlapping them: those hold the device open and keep it off the graph-driver election,
  # this decides which sinks the card offers at all. See scripts/alsa-ucm2/.
  for f in USB-Audio/conf.d/054c-0ce6.conf USB-Audio/conf.d/054c-0df2.conf \
           USB-Audio/RubyFunk/DualSense-PS5-Haptic.conf \
           USB-Audio/RubyFunk/DualSense-PS5-Haptic-HiFi.conf; do
    install -Dm0644 "$R/scripts/alsa-ucm2/$f" "$pkgdir/usr/share/alsa/ucm2/$f"
  done
  # Managed gamescope takeover on DM-autologin boxes: root helper + polkit action so the host can
  # stop/restore the display manager for the stream. Arch has no /usr/libexec — install under
  # /usr/lib/rubyfunk and rewrite the policy's exec.path annotation to match (the host probes both).
  install -Dm0755 "$R/scripts/pf-dm-helper"           "$pkgdir/usr/lib/rubyfunk/pf-dm-helper"
  install -Dm0644 "$R/scripts/io.github.gunu3371.rubyfunk.dm-helper.policy" \
    "$pkgdir/usr/share/polkit-1/actions/io.github.gunu3371.rubyfunk.dm-helper.policy"
  sed -i 's#/usr/libexec/rubyfunk/pf-dm-helper#/usr/lib/rubyfunk/pf-dm-helper#' \
    "$pkgdir/usr/share/polkit-1/actions/io.github.gunu3371.rubyfunk.dm-helper.policy"
  # ...and the other half of stopping a display manager: with it stopped the box has no active
  # local session, so logind's power actions fall to auth_admin_keep and Steam's power menu goes
  # quiet mid-stream. No path annotation to rewrite — a .rules file names a group, not a binary.
  install -Dm0644 "$R/packaging/linux/49-rubyfunk-power.rules" \
    "$pkgdir/usr/share/polkit-1/rules.d/49-rubyfunk-power.rules"
  # Web-console-triggered updates (host-update-from-web-console.md §7): root helper + oneshot
  # unit + group-scoped polkit rule. Same no-libexec relocation as pf-dm-helper, with the
  # unit's ExecStart rewritten to match. On pacman the helper additionally requires the
  # explicit PACMAN_FULL_SYSUPGRADE opt-in (partial upgrades are against Arch doctrine).
  install -Dm0755 "$T/pf-update"                      "$pkgdir/usr/lib/rubyfunk/pf-update"
  install -Dm0644 "$R/packaging/linux/rubyfunk-update.service" \
    "$pkgdir/usr/lib/systemd/system/rubyfunk-update.service"
  sed -i 's#/usr/libexec/rubyfunk/pf-update#/usr/lib/rubyfunk/pf-update#' \
    "$pkgdir/usr/lib/systemd/system/rubyfunk-update.service"
  install -Dm0644 "$R/packaging/linux/49-rubyfunk-update.rules" \
    "$pkgdir/usr/share/polkit-1/rules.d/49-rubyfunk-update.rules"
  # The host state rubyfunk-host.install shares with every other format, relocated like pf-update,
  # and the groups it creates (pacman's sysusers hook applies the file too).
  install -Dm0755 "$R/packaging/linux/post-install.sh" "$pkgdir/usr/lib/rubyfunk/post-install"
  install -Dm0644 "$R/packaging/linux/rubyfunk.sysusers" "$pkgdir/usr/lib/sysusers.d/rubyfunk.conf"
  # An upgrade of any rubyfunk server package restarts the running services, once per transaction.
  install -Dm0755 "$R/packaging/linux/restart-user-units.sh" "$pkgdir/usr/lib/rubyfunk/restart-user-units"
  install -Dm0644 "$R/packaging/arch/rubyfunk-restart.hook" \
    "$pkgdir/usr/share/libalpm/hooks/rubyfunk-restart.hook"
  # vhci-hcd autoload — usbip transport for the virtual Steam Deck pad (Steam only adopts USB pads)
  install -Dm0644 "$R/scripts/rubyfunk-modules.conf" "$pkgdir/usr/lib/modules-load.d/rubyfunk.conf"
  # 32 MB UDP socket buffers (send-side headroom at high bitrate)
  install -Dm0644 "$R/scripts/99-rubyfunk-net.conf"  "$pkgdir/usr/lib/sysctl.d/99-rubyfunk-net.conf"
  # Nice-limit headroom for the host's data-plane threads: raises the user-session RLIMIT_NICE so
  # pf-frame's setpriority() works on boxes without RealtimeKit (with rtkit the host never needs
  # it). A limit, not a grant — and NEVER a file capability on the host binary (see the KWin
  # identification note in rubyfunk-host.install). Applies from the next login.
  install -Dm0644 "$R/packaging/linux/50-rubyfunk-nice.conf" \
    "$pkgdir/usr/lib/systemd/system/user@.service.d/50-rubyfunk-nice.conf"
  # systemd USER units (the host runs in the graphical session, not as root); repoint ExecStart.
  install -Dm0644 "$R/scripts/rubyfunk-host.service" "$pkgdir/usr/lib/systemd/user/rubyfunk-host.service"
  sed -i 's#%h/rubyfunk/target/release/rubyfunk-host#/usr/bin/rubyfunk-host#' \
    "$pkgdir/usr/lib/systemd/user/rubyfunk-host.service"
  # Optional drop-in for a DESKTOP-LOGIN host: binds the host to graphical-session.target so a
  # Plasma/GNOME restart restarts it instead of leaving it on a dead compositor connection. Shipped
  # under /usr/share (NOT as an active drop-in) because it is wrong for the appliance route — the
  # operator copies it into ~/.config/systemd/user/rubyfunk-host.service.d/ when they want it.
  install -Dm0644 "$R/scripts/rubyfunk-host-desktop-session.conf" \
    "$pkgdir/usr/share/rubyfunk/rubyfunk-host-desktop-session.conf"
  # Install-kind + channel marker, read by the host's update-check surface (planning:
  # host-update-from-web-console.md §4.1). A canary build's pkgrel is `0.<zero-padded run>`.
  local _pf_update_channel=stable
  [[ $pkgrel == 0.* ]] && _pf_update_channel=canary
  printf 'pacman %s\n' "$_pf_update_channel" | \
    install -Dm0644 /dev/stdin "$pkgdir/usr/share/rubyfunk/install-kind"
  install -Dm0644 "$R/scripts/rubyfunk-kde-session.service" "$pkgdir/usr/lib/systemd/user/rubyfunk-kde-session.service"
  sed -i 's#%h/rubyfunk/scripts/headless/run-headless-kde.sh#/usr/share/rubyfunk/headless/run-headless-kde.sh#' \
    "$pkgdir/usr/lib/systemd/user/rubyfunk-kde-session.service"
  # KWin Desktop-mode authorization: non-launcher .desktop whose X-KDE-Wayland-Interfaces lets the
  # host bind KWin's restricted zkde_screencast (virtual output) + fake_input globals on an
  # interactive Plasma session. Must ship with the host (KWin caches the per-exe grant on first
  # connect). See the file's header comment.
  install -Dm0644 "$R/packaging/linux/io.github.gunu3371.rubyfunk.host.desktop" \
    "$pkgdir/usr/share/applications/io.github.gunu3371.rubyfunk.host.desktop"
  # Status tray: per-user SNI icon + the hicolor status icons it names. Its autostart entry is per
  # user, written by the host from the tray_autostart setting.
  install -Dm0755 "$T/rubyfunk-tray" "$pkgdir/usr/bin/rubyfunk-tray"
  install -Dm0644 "$R/packaging/linux/io.github.gunu3371.rubyfunk.starthost.desktop" \
    "$pkgdir/usr/share/applications/io.github.gunu3371.rubyfunk.starthost.desktop"
  local sz png
  for sz in 22x22 48x48; do
    for png in "$R"/packaging/linux/icons/hicolor/$sz/apps/*.png; do
      install -Dm0644 "$png" "$pkgdir/usr/share/icons/hicolor/$sz/apps/$(basename "$png")"
    done
  done
  # headless session helpers + env templates + OpenAPI doc
  install -Dm0755 "$R/scripts/headless/run-headless-kde.sh"  "$pkgdir/usr/share/rubyfunk/headless/run-headless-kde.sh"
  install -Dm0755 "$R/scripts/headless/run-headless-sway.sh" "$pkgdir/usr/share/rubyfunk/headless/run-headless-sway.sh"
  install -Dm0644 "$R/scripts/headless/kde-authorized"       "$pkgdir/usr/share/rubyfunk/headless/kde-authorized"
  install -Dm0644 "$R/scripts/headless/rubyfunk-sink.conf"  "$pkgdir/usr/share/rubyfunk/headless/rubyfunk-sink.conf"
  install -Dm0644 "$R/scripts/host.env.example"              "$pkgdir/usr/share/rubyfunk/host.env.example"
  install -Dm0644 "$R/packaging/bazzite/host.env"            "$pkgdir/usr/share/rubyfunk/host.env.bazzite"
  install -Dm0644 "$R/packaging/kde/host.env"                "$pkgdir/usr/share/rubyfunk/host.env.kde"
  # Headless GAME-mode fix: gamescope-session-plus drop-in that uses the headless backend when no
  # display is connected (so SteamOS/Bazzite "Switch to Game Mode" works on a display-less streaming
  # host). No-op on display-attached boxes; sourced as /etc/gamescope-session-plus/sessions.d/steam.
  install -Dm0644 "$R/packaging/bazzite/gamescope-headless-session" \
    "$pkgdir/etc/gamescope-session-plus/sessions.d/steam"
  install -Dm0644 "$R/api/openapi.json"                 "$pkgdir/usr/share/rubyfunk/openapi.json"
  # The session drop-in as a TEMPLATE the Omarchy setup script installs into the user's unit dir.
  # It is already shipped to /usr/lib/systemd/user/... as a documented no-op elsewhere; here it is
  # a file `rubyfunk-omarchy setup` can copy, because on Omarchy graphical-session.target really
  # starts and binding to it is what makes the host restart with the session.
  install -Dm0644 "$R/scripts/rubyfunk-host-desktop-session.conf" \
    "$pkgdir/usr/share/rubyfunk/rubyfunk-host-desktop-session.conf"
  # Omarchy integration (design/omarchy-integration.md). The script is INSTALLED, never run: a
  # package that opened firewall ports or edited a user's config on install would be doing both
  # behind the operator's back. `rubyfunk-omarchy setup` is the consent step.
  install -Dm0755 "$R/packaging/linux/omarchy/rubyfunk-omarchy" \
    "$pkgdir/usr/bin/rubyfunk-omarchy"
  for h in pairing-pending stream-started stream-stopped idle-guard; do
    install -Dm0755 "$R/packaging/linux/omarchy/hooks/$h" \
      "$pkgdir/usr/share/rubyfunk/omarchy/hooks/$h"
  done
  install -Dm0644 "$R/packaging/linux/omarchy/themed/rubyfunk.json.tpl" \
    "$pkgdir/usr/share/rubyfunk/omarchy/themed/rubyfunk.json.tpl"
  # The Quickshell bar widget (see plugin/README.md). Shipped as data only — the shell discovers
  # plugins in the USER's config dir, so `rubyfunk-omarchy setup` copies it there with consent,
  # the same split as the hooks above.
  for f in manifest.json Panel.qml Service.qml Model.js README.md; do
    install -Dm0644 "$R/packaging/linux/omarchy/plugin/$f" \
      "$pkgdir/usr/share/rubyfunk/omarchy/plugin/$f"
  done
  # Firewall openers — NOT auto-enabled (an Arch package never touches the admin's running firewall).
  # Stock Arch ships no firewall; CachyOS ships ufw; some spins (EndeavourOS) enable firewalld — so we
  # install BOTH a ufw application profile and firewalld service definitions, and the one for whatever
  # firewall you actually run is a one-liner. See README.md → Firewall.
  #   ufw:       sudo ufw allow rubyfunk-native            (or rubyfunk-gamestream)
  #   firewalld: sudo firewall-cmd --reload && sudo firewall-cmd --permanent --add-service=rubyfunk-native && sudo firewall-cmd --reload
  install -Dm0644 "$R/packaging/linux/rubyfunk.ufw" \
    "$pkgdir/etc/ufw/applications.d/rubyfunk"
  install -Dm0644 "$R/packaging/linux/rubyfunk-gamestream.xml" \
    "$pkgdir/usr/lib/firewalld/services/rubyfunk-gamestream.xml"
  install -Dm0644 "$R/packaging/linux/rubyfunk-native.xml" \
    "$pkgdir/usr/lib/firewalld/services/rubyfunk-native.xml"
  # Web console opener (TCP 47992) — only meaningful with the optional rubyfunk-web package; opened
  # deliberately (see README.md → Firewall). ufw's equivalent is the rubyfunk-web profile above.
  install -Dm0644 "$R/packaging/linux/rubyfunk-web.xml" \
    "$pkgdir/usr/lib/firewalld/services/rubyfunk-web.xml"
  install -Dm0644 "$R/LICENSE-MIT"    "$pkgdir/usr/share/licenses/rubyfunk-host/LICENSE-MIT"
  install -Dm0644 "$R/LICENSE-APACHE" "$pkgdir/usr/share/licenses/rubyfunk-host/LICENSE-APACHE"
  install -Dm0644 "$R/README.md"      "$pkgdir/usr/share/doc/rubyfunk-host/README.md"
}

package_rubyfunk-client() {
  pkgdesc="Low-latency desktop/game streaming CLIENT — native GTK4/libadwaita Linux app"
  # The GTK4/libadwaita shell + its Vulkan session streamer: SDL3 gamepads, native decode
  # (Vulkan Video, VAAPI, and openh264 + rav1d in software), PipeWire audio/mic.
  # No ffmpeg since M10: the client links no libav* at all, and its VAAPI rung dlopens libva
  # rather than linking it, so the driver optdepends below are all it needs.
  # vulkan-icd-loader: the session binary loads libvulkan at runtime (ash) for both its decoder
  # and its ash/Skia presenter.
  # NOT pipewire-pulse: the client speaks NATIVE PipeWire (audio.rs drives libpipewire-0.3
  # directly for both playback and the mic uplink) and never opens a Pulse socket, so the
  # compat shim buys it nothing — while `pipewire-pulse` CONFLICTS with `pulseaudio`, which
  # made the package uninstallable for anyone keeping real PulseAudio. Matches the .deb
  # (Recommends) and the RPM (Recommends, "degrade gracefully without it").
  # rubyfunk-icons: the shared brand mark — see the host's depends note.
  depends=('gtk4' 'libadwaita' 'sdl3' 'pipewire' 'wireplumber'
           'libglvnd' 'vulkan-icd-loader' 'rubyfunk-icons')
  optdepends=('libva-mesa-driver: VAAPI hardware decode on AMD (incl. Steam Deck); software fallback otherwise'
              'intel-media-driver: VAAPI hardware decode on Intel'
              'vulkan-radeon: Vulkan Video decode + presenter on AMD'
              'vulkan-nouveau: Vulkan Video decode + presenter on NVIDIA (nvidia-utils for the proprietary ICD)'
              'gamescope: run the client fullscreen in a Gaming-Mode session')
  install=rubyfunk-client.install
  local R; R="$(_repo)"; local T="$srcdir/target/release"

  install -Dm0755 "$T/rubyfunk-client"  "$pkgdir/usr/bin/rubyfunk-client"
  # The session streamer the shell execs for a connect (resolved as its sibling in /usr/bin).
  install -Dm0755 "$T/rubyfunk-session" "$pkgdir/usr/bin/rubyfunk-session"
  # The headless CLI (design/client-architecture-split.md §4).
  install -Dm0755 "$T/rubyfunk" "$pkgdir/usr/bin/rubyfunk"
  install -Dm0644 "$R/packaging/linux/io.github.gunu3371.rubyfunk.desktop" \
    "$pkgdir/usr/share/applications/io.github.gunu3371.rubyfunk.desktop"
  # Second launcher, straight into the gamepad console (`--browse`) — the couch entry point.
  install -Dm0644 "$R/packaging/linux/io.github.gunu3371.rubyfunk.console.desktop" \
    "$pkgdir/usr/share/applications/io.github.gunu3371.rubyfunk.console.desktop"
  # DualSense hidraw access (full pad fidelity through SDL's HIDAPI driver).
  install -Dm0644 "$R/scripts/70-rubyfunk-client.rules" \
    "$pkgdir/usr/lib/udev/rules.d/70-rubyfunk-client.rules"
  # 32 MB UDP recv buffer (so high-bitrate streams don't overflow the kernel socket buffer).
  install -Dm0644 "$R/scripts/99-rubyfunk-client-net.conf" \
    "$pkgdir/usr/lib/sysctl.d/99-rubyfunk-client-net.conf"
  # One-tap client updates (`rubyfunk-client --apply-update`, which is what the Decky plugin
  # runs): the same root helper the host package ships, under the CLIENT's own paths — a
  # client-only box (a Deck) has no host package, and two packages owning one path is a hard
  # pacman conflict. Same no-libexec relocation as the host's copy, with the unit's ExecStart
  # rewritten to match. On pacman the helper additionally requires the explicit
  # PACMAN_FULL_SYSUPGRADE opt-in (partial upgrades are against Arch doctrine).
  install -Dm0755 "$T/pf-update" "$pkgdir/usr/lib/rubyfunk/pf-update-client"
  install -Dm0644 "$R/packaging/linux/rubyfunk-client-update.service" \
    "$pkgdir/usr/lib/systemd/system/rubyfunk-client-update.service"
  sed -i 's#/usr/libexec/rubyfunk/pf-update#/usr/lib/rubyfunk/pf-update-client#' \
    "$pkgdir/usr/lib/systemd/system/rubyfunk-client-update.service"
  install -Dm0644 "$R/packaging/linux/49-rubyfunk-client-update.rules" \
    "$pkgdir/usr/share/polkit-1/rules.d/49-rubyfunk-client-update.rules"
  # The rubyfunk-update group, from the file the host ships under its own name.
  install -Dm0644 "$R/packaging/linux/rubyfunk.sysusers" \
    "$pkgdir/usr/lib/sysusers.d/rubyfunk-client.conf"
  # Install-kind + channel marker for the CLIENT, read by `rubyfunk-client --check-update`
  # (planning: host-update-from-web-console.md §4.1). Its own directory, matching the RPM (where
  # the host subpackage's %{_datadir}/rubyfunk/* glob would otherwise co-own a sibling file) —
  # one path per product across every format, so the detector has one answer to remember.
  local _pf_client_channel=stable
  [[ $pkgrel == 0.* ]] && _pf_client_channel=canary
  printf 'pacman %s\n' "$_pf_client_channel" | \
    install -Dm0644 /dev/stdin "$pkgdir/usr/share/rubyfunk-client/install-kind"
  install -Dm0644 "$R/LICENSE-MIT"    "$pkgdir/usr/share/licenses/rubyfunk-client/LICENSE-MIT"
  install -Dm0644 "$R/LICENSE-APACHE" "$pkgdir/usr/share/licenses/rubyfunk-client/LICENSE-APACHE"
}

package_rubyfunk-seats() {
  pkgdesc="rubyfunk seat supervisor and door — a user, a logind session and a host per profile (root daemon, ships disabled)"
  # What the supervisor and the door helper run: useradd/groupadd/usermod, runuser and setpriv,
  # setfacl, loginctl/systemctl, pkill. The host depends on this package at its own version; a
  # depend back would be a cycle pacman warns about.
  depends=('shadow' 'util-linux' 'acl' 'systemd' 'procps-ng')
  install=rubyfunk-seats.install
  local R; R="$(_repo)"; local T="$srcdir/target/release"

  # /usr/libexec, not the /usr/lib/rubyfunk the host's helpers use: the seat units and
  # `rubyfunk-seats doctor` name this path, so it is the same on every distro.
  install -Dm0755 "$T/rubyfunk-seats" "$pkgdir/usr/libexec/rubyfunk/rubyfunk-seats"
  local f
  for f in seat-session seat-reap; do
    install -Dm0755 "$R/packaging/linux/$f" "$pkgdir/usr/libexec/rubyfunk/$f"
  done
  for f in rubyfunk-seats.service rubyfunk-seat@.service; do
    install -Dm0644 "$R/packaging/linux/$f" "$pkgdir/usr/lib/systemd/system/$f"
  done
  install -Dm0644 "$R/packaging/linux/rubyfunk-seats-user.conf" "$pkgdir/usr/lib/systemd/system/user@.service.d/50-rubyfunk-seats.conf"
  install -Dm0644 "$R/packaging/linux/rubyfunk-seat.pam" "$pkgdir/usr/lib/pam.d/rubyfunk-seat"
  install -Dm0644 "$R/packaging/linux/rubyfunk-seats.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/rubyfunk-seats.conf"
  # A seat's pads: udev hands each one to its seat's user alone.
  install -Dm0644 "$R/packaging/linux/65-rubyfunk-seats.rules" "$pkgdir/usr/lib/udev/rules.d/65-rubyfunk-seats.rules"
  # The door: the box's host as a system service, and the root helper the console turns it on with.
  install -Dm0755 "$R/packaging/linux/door-helper" "$pkgdir/usr/libexec/rubyfunk/door-helper"
  for f in rubyfunk-door.service rubyfunk-web-door.service rubyfunk-door-on@.service rubyfunk-door-off@.service; do
    install -Dm0644 "$R/packaging/linux/$f" "$pkgdir/usr/lib/systemd/system/$f"
  done
  install -Dm0644 "$R/packaging/linux/49-rubyfunk-door.rules" "$pkgdir/usr/share/polkit-1/rules.d/49-rubyfunk-door.rules"
  install -Dm0644 "$R/LICENSE-MIT"    "$pkgdir/usr/share/licenses/rubyfunk-seats/LICENSE-MIT"
  install -Dm0644 "$R/LICENSE-APACHE" "$pkgdir/usr/share/licenses/rubyfunk-seats/LICENSE-APACHE"
}

# The brand mark both the host's and the client's desktop entries name (`Icon=io.github.gunu3371.rubyfunk`).
# Its own package because each side must work STANDALONE (a host-only Omarchy box wants a webapp
# icon; a client-only laptop wants an app icon), and the same path in two packages is a pacman
# file conflict on any box that installs both.
package_rubyfunk-icons() {
  pkgdesc="RubyFunk brand icons shared by the host and client packages"
  depends=()
  local R; R="$(_repo)"
  install -Dm0644 "$R/packaging/linux/icons/hicolor/scalable/apps/io.github.gunu3371.rubyfunk.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.gunu3371.rubyfunk.svg"
}

package_rubyfunk-web() {
  pkgdesc="rubyfunk management web console (Nitro SSR on bun, HTTPS/HTTP-1.1 over TLS) — pairing + status in the browser"
  # Runs on rubyfunk-bun's private bun (Bun.serve), pinned to this exact build. Auto-wired to the
  # host's mgmt token + identity cert via the systemd --user units; enable with
  # `systemctl --user enable --now rubyfunk-web`. No nodejs or system bun dependency.
  depends=("rubyfunk-bun=${pkgver}-${pkgrel}")
  local R; R="$(_repo)"

  # Pre-built bun-preset bundle (from build()) + a PATH-stable launcher (matches the .deb/.rpm).
  install -d "$pkgdir/usr/share/rubyfunk-web/.output"
  cp -r "$R/web/.output/server" "$pkgdir/usr/share/rubyfunk-web/.output/server"
  cp -r "$R/web/.output/public" "$pkgdir/usr/share/rubyfunk-web/.output/public"
  install -d "$pkgdir/usr/bin"
  printf '%s\n' '#!/bin/sh' 'exec /usr/lib/rubyfunk-bun/bun /usr/share/rubyfunk-web/.output/server/index.mjs "$@"' \
    > "$pkgdir/usr/bin/rubyfunk-web-server"
  chmod 0755 "$pkgdir/usr/bin/rubyfunk-web-server"
  # systemd USER units: the console runs per-user; web-init generates the login password on first start.
  install -Dm0644 "$R/scripts/rubyfunk-web.service"      "$pkgdir/usr/lib/systemd/user/rubyfunk-web.service"
  install -Dm0644 "$R/scripts/rubyfunk-web-init.service" "$pkgdir/usr/lib/systemd/user/rubyfunk-web-init.service"
  install -Dm0755 "$R/scripts/web-init.sh"                "$pkgdir/usr/share/rubyfunk-web/web-init.sh"
  install -Dm0644 "$R/web/web.env.example"                "$pkgdir/usr/share/rubyfunk-web/web.env.example"
  install -Dm0644 "$R/LICENSE-MIT"    "$pkgdir/usr/share/licenses/rubyfunk-web/LICENSE-MIT"
  install -Dm0644 "$R/LICENSE-APACHE" "$pkgdir/usr/share/licenses/rubyfunk-web/LICENSE-APACHE"
}

package_rubyfunk-scripting() {
  pkgdesc="rubyfunk plugin/script runner (Effect SDK on bun) — supervises host automation scripts + rubyfunk-plugin-* packages"
  # bubblewrap builds each plugin's sandbox; the runner starts no plugin without it. The runtime is
  # rubyfunk-bun's private bun (it import()s the operator's .ts plugins), pinned to this build.
  depends=('bubblewrap' "rubyfunk-bun=${pkgver}-${pkgrel}")
  install=rubyfunk-scripting.install
  backup=('etc/apparmor.d/rubyfunk-scripting')
  local R; R="$(_repo)"

  # Pre-built self-contained bundle (from build()) + a PATH-stable launcher (matches the .deb/.rpm).
  install -Dm0644 "$srcdir/runner-cli.js" "$pkgdir/usr/share/rubyfunk-scripting/runner-cli.js"
  install -d "$pkgdir/usr/bin"
  printf '%s\n' '#!/bin/sh' 'exec /usr/lib/rubyfunk-bun/bun /usr/share/rubyfunk-scripting/runner-cli.js "$@"' \
    > "$pkgdir/usr/bin/rubyfunk-scripting"
  chmod 0755 "$pkgdir/usr/bin/rubyfunk-scripting"
  # systemd USER unit — installed but NOT auto-enabled (opt-in). Enable once you have automation:
  #   systemctl --user enable --now rubyfunk-scripting
  install -Dm0644 "$R/scripts/rubyfunk-scripting.service" "$pkgdir/usr/lib/systemd/user/rubyfunk-scripting.service"
  # Where AppArmor restricts unprivileged user namespaces, the generator trades the unit's namespace
  # sandbox for this profile.
  install -Dm0644 "$R/packaging/linux/apparmor/rubyfunk-scripting" "$pkgdir/etc/apparmor.d/rubyfunk-scripting"
  install -Dm0755 "$R/packaging/linux/rubyfunk-scripting-apparmor.generator" \
    "$pkgdir/usr/lib/systemd/user-generators/rubyfunk-scripting-apparmor"
  install -Dm0644 "$R/LICENSE-MIT"    "$pkgdir/usr/share/licenses/rubyfunk-scripting/LICENSE-MIT"
  install -Dm0644 "$R/LICENSE-APACHE" "$pkgdir/usr/share/licenses/rubyfunk-scripting/LICENSE-APACHE"
}

# The build env's bun, vendored once for web and scripting. A private dir, never on PATH, so it
# never collides with a system-wide bun. A native binary, so the package is arch-specific.
package_rubyfunk-bun() {
  pkgdesc="Bun runtime for rubyfunk-web and rubyfunk-scripting (private, not on PATH)"
  depends=()
  install -Dm0755 "$(command -v bun)" "$pkgdir/usr/lib/rubyfunk-bun/bun"
}
