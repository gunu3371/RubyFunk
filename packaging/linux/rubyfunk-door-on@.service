# Turn on "Reachable without logging in" for the user named by the instance, as a root oneshot.
# Started, never enabled, by that user's own host (`systemctl start rubyfunk-door-on@<user>`),
# which 49-rubyfunk-door.rules allows for members of the `rubyfunk-update` group. The helper
# refuses any user who isn't one. systemd runs one at a time and the journal keeps the account.
[Unit]
Description=rubyfunk door: turn on for %i (root helper)

[Service]
Type=oneshot
ExecStart=/usr/libexec/rubyfunk/door-helper on %i
TimeoutStartSec=180
