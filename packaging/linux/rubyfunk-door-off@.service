# Turn off "Reachable without logging in" for the user named by the instance, as a root oneshot.
# Started, never enabled, by the door (`systemctl start rubyfunk-door-off@<user>`) or by a member
# of the `rubyfunk-update` group; see 49-rubyfunk-door.rules. The helper refuses any user who
# isn't one.
[Unit]
Description=rubyfunk door: turn off for %i (root helper)

[Service]
Type=oneshot
ExecStart=/usr/libexec/rubyfunk/door-helper off %i
TimeoutStartSec=180
