#!/usr/bin/env bash
#
# rubyfunk hook: a stream ended → a low-urgency Omarchy toast.
# Wired as a `stream.stopped` entry in ~/.config/rubyfunk/hooks.json by `rubyfunk-omarchy setup`.

set -euo pipefail

client="${PF_EVENT_STREAM_CLIENT:-a client}"
command -v omarchy-notification-send >/dev/null || exit 0
omarchy-notification-send --urgency=low --icon=io.github.gunu3371.rubyfunk "RubyFunk" "$client disconnected"
