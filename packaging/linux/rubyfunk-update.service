# The web-console-triggered host update, as a root oneshot (planning:
# host-update-from-web-console.md §7). Started — never enabled — by the unprivileged host via
# `systemctl start rubyfunk-update.service`, authorized by the polkit rule
# (49-rubyfunk-update.rules) for members of the `rubyfunk-update` group. systemd gives us
# single-flight (a second start while active fails) and journal capture for free; the helper
# writes its machine-readable outcome to /var/lib/rubyfunk-update/update-result.json: a directory
# only root writes, unlike /var/lib/rubyfunk, which is the door's.
[Unit]
Description=rubyfunk host update (root helper)
# Network is a hard prerequisite for every leg (package manager / sysext feed).
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/rubyfunk/pf-update apply
# /var/lib/rubyfunk-update, root's, 0755 so the host reads the result.
StateDirectory=rubyfunk-update
# The helper drives the distro package manager, which needs the real system — no sandboxing
# directives here on purpose; the constraint is the FIXED ExecStart (no parameters exist).
