# ufw application profile for the rubyfunk host — installed to
# /etc/ufw/applications.d/rubyfunk by the .deb and the Arch/CachyOS package.
#
# This is the ufw analogue of the firewalld service definitions
# (rubyfunk-native.xml / rubyfunk-gamestream.xml): it turns opening the host's
# ports into a one-liner on the distros that use ufw instead of firewalld
# (CachyOS ships ufw enabled; Debian/Ubuntu ship it installed-but-inactive). ufw
# reads this directory on every command, so no reload is needed after the
# package drops the file — just:
#
#     sudo ufw allow rubyfunk-native        # the secure native rubyfunk host (the default)
#     sudo ufw allow rubyfunk-gamestream    # add GameStream/Moonlight compat (opt-in)
#     sudo ufw allow rubyfunk-web           # reach the web console from the LAN (if rubyfunk-web is installed)
#     sudo ufw app info rubyfunk-native     # show what a profile opens
#
# Same port map as the firewalld services. Video and audio ride the QUIC port
# (9777), so there is no second port to open.
#
# 9778/udp is browser streaming (console: Browser streaming). Nothing listens
# there until it is switched on, and the console switch cannot open a firewall.
# 9779-9782/udp are the seats a door (Reachable without logging in) redirects a client to,
# 9783-9786/udp the same seats' browser streaming.

[rubyfunk-native]
title=rubyfunk host (native punktfunk/2)
description=punktfunk/2 native streaming: QUIC control plane + browser streaming + seats + mDNS auto-discovery + mgmt/library API (HTTPS + mTLS)
ports=9777/udp|9778:9786/udp|5353/udp|47990/tcp

[rubyfunk-gamestream]
title=rubyfunk host (GameStream/Moonlight)
description=GameStream/Moonlight compatibility ports (opt-in, trusted LAN only)
ports=47984,47989,48010/tcp|47998:48010/udp|5353/udp

# The mgmt REST API (TCP 47990, in the rubyfunk-native profile above) binds all interfaces by
# default so paired clients can browse the game library over mTLS. Off-loopback it exposes ONLY the
# read-only status + library endpoints, and only to a paired client certificate; every admin action
# (arming pairing, removing devices, session control, library edits) is honored over loopback only.
# Run the host with `--mgmt-bind 127.0.0.1:47990` to keep 47990 loopback-only (then don't open it).
#
# The optional web console (the separate rubyfunk-web package). Open only if you installed it and
# want to reach it from another device — it binds all interfaces on TCP 47992 (HTTPS, login-gated),
# and serves plugin UIs from a SEPARATE ORIGIN on TCP 47993.
#
# 47993 is not a second console. A plugin's interface is third-party code, and serving it on the
# console's own origin let it act as the logged-in operator (security-review 2026-08-05 H-3). Same
# host, same certificate, different port: a different ORIGIN to the browser, so the same-origin
# policy is the boundary — but still the same SITE, so the login session still reaches it. It is
# login-gated exactly like the console, and only needed for plugins that ship a UI.
[rubyfunk-web]
title=rubyfunk web console
description=The optional rubyfunk management web console (HTTPS, login-gated) reachable from the LAN, plus the separate-origin port its plugin UIs are served on
ports=47992,47993/tcp
