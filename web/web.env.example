# rubyfunk web console — packaged config reference.
#
# On a `apt install rubyfunk-web` install you DO NOT edit anything: the systemd --user units wire
# everything automatically —
#   rubyfunk-web.service sets RUBYFUNK_MGMT_URL=https://127.0.0.1:47990,
#   PORT=47992, HOST=0.0.0.0, the RUBYFUNK_UI_TLS_* cert paths + RUBYFUNK_UI_SECURE=1, and sources:
#     ~/.config/rubyfunk/mgmt-token    (written by the host's `serve` — the shared bearer token)
#     ~/.config/rubyfunk/web-password  (rubyfunk-web-init generates it; the console hashes it)
#     ~/.config/rubyfunk/{cert,key}.pem (the host identity — the console serves HTTPS with it)
#
# This file documents the variables for a MANUAL deploy (running `bun .output/server/index.mjs`
# yourself — the console runs on bun: `Bun.serve` is a Bun API, node can't run it). The mgmt API is
# HTTPS with the host's self-signed loopback cert; the proxy accepts it ONLY for that loopback hop,
# scoped in code (Bun per-request TLS) — so NODE_TLS_REJECT_UNAUTHORIZED is deliberately unset.
RUBYFUNK_MGMT_URL=https://127.0.0.1:47990
PORT=47992
HOST=0.0.0.0

# Serve the console over HTTPS (HTTP/1.1 over TLS) with the host's own identity cert. BOTH paths
# set ⇒ HTTPS. (No HTTP/2 or HTTP/3: Bun.serve has no HTTP/2 server, and a browser won't speak
# HTTP/3/QUIC against a self-signed host cert — so HTTP/1.1 over TLS is what's offered.)
# Name the LEGACY pair below: the server prefers native-cert.pem/native-key.pem beside it when both
# exist (nitro-entry/tls-paths.mjs), and falls back to these on a host that never took the split.
RUBYFUNK_UI_TLS_CERT=%h/.config/rubyfunk/cert.pem
RUBYFUNK_UI_TLS_KEY=%h/.config/rubyfunk/key.pem
# Mark the session cookie Secure (required once served over TLS):
RUBYFUNK_UI_SECURE=1

# Match the host's ~/.config/rubyfunk/mgmt-token (auto-generated by the host if unset):
RUBYFUNK_MGMT_TOKEN=

# Console login password, as the salted argon2id hash the server compares against — single-quoted,
# because the modular-crypt form is full of `$` and this file is sourced by a shell on some hosts.
# The server writes this line itself: set RUBYFUNK_UI_PASSWORD below to the clear password you want
# and the first successful sign-in replaces it with the hash. Fails closed if neither is set.
RUBYFUNK_UI_PASSWORD_HASH=
# DEPRECATED, accepted for one release. Also the reset: a clear line put back here wins over the
# hash above, and signing in with it rotates the hash and logs every other session out.
RUBYFUNK_UI_PASSWORD=
# Where the server rewrites that line. Defaults to ~/.config/rubyfunk/web-password; name the file
# the launcher actually loads when it is somewhere else (SteamOS keeps it in web.env).
# RUBYFUNK_UI_PASSWORD_FILE=
